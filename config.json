{
  "llm": {
    "provider": "ollama",
    "provider_config": {
      "model_name": "gpt-oss:20b",
      "generation_config": {
        "temperature": 0.5,
        "num_ctx": 20000,
        "num_predict": -1
      }
    }
  },

  "context": {
    "safe_margin": -1,
    "compaction_target_tokens": 16360
  },

  "retrieval": {
    "top_k": 10
  },

  "models": {
    "embedding": {
      "model_name": "intfloat/multilingual-e5-base"
    },
    "reranker": {
      "model_name": "BAAI/bge-reranker-v2-m3"
    }
  },

  "max_agent_iterations": 100
}
