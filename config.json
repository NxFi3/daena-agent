{
  "llm": {
    "provider": "ollama",
    "provider_config": {
      "model_name": "gpt-oss:20b",
      "generation_config": {
        "temperature": 0.3,
        "num_thread": 16,
        "think": "low"
      }
    }
  },
  "context": {
    "preserve_thinking": true,
    "safe_margin": -1,
    "recent_event_limit": 80,
    "compaction_enabled": true,
    "compaction_target_tokens": 8192,
    "max_prompt_tokens": 65536,
    "compaction_trigger_ratio": 0.78
  },
  "guard_level": "strict",
  "tools": {
    "disabled": []
  },
  "observation_cache": {
    "enabled": true
  },
  "retrieval": {
    "top_k": 3
  },
  "security": {
    "workspace_only": false,
    "allow_background": true,
    "allow_network_tools": true,
    "force_approve": true
  },
  "models": {
    "embedding": {
      "model_name": "intfloat/multilingual-e5-base"
    },
    "reranker": {
      "model_name": "BAAI/bge-reranker-v2-m3"
    }
  },
  "max_agent_iterations": 300,
  "max_auto_continuations": 4,
  "max_no_progress_segments": 2,
  "completion_review": {
    "enabled": true,
    "max_retries": 5,
    "recovery_interval": 3,
    "max_recovery_checks": 4
  },
  "experience": {
    "enabled": true
  }
}
