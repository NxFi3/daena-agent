+    def _type_in_chunks(args: dict[str, Any]) -> str:
+        """Type long text in bounded chunks; stop at the first failure, never retry."""
+        text = str(args["text"])
+        chunks = [text[i:i + _TYPE_CHUNK_CHARS] for i in range(0, len(text), _TYPE_CHUNK_CHARS)]
